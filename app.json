{
  "expo": {
    "name": "Grow Lab",
    "slug": "grow-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.growlab.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#161B2F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.growlab.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#05080A",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Grow Lab usa le tue foto per analizzare i problemi delle piante.",
          "cameraPermission": "Grow Lab usa la fotocamera per fotografare le piante e riconoscere i problemi."
        }
      ]
    ]
  }
}
